@model IEnumerable<SistemaAPI.DTOs.PublicProductInfoDto>
@{
    ViewData["Title"] = "Produtos Utilizados";
}

<section class="py-5 text-center">
    <h1 class="fw-bold" style="color:#2A310E;">Produtos Utilizados nos Tratamentos</h1>
    <p class="text-muted">Conheça os cosméticos profissionais que usamos</p>
</section>

<div class="container pb-5">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm border-0">
                    <img src="@item.ImageFullPath" class="card-img-top" alt="@item.Name">
                    <div class="card-body">
                        <h5 class="fw-bold">@item.Name</h5>
                        <p class="text-muted small">@item.Description</p>
                        <a href="@Url.Action("Details", "PublicProductInfo", new { id = item.Id })" class="btn btn-outline-secondary">Ver Detalhes</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

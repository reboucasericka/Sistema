@model SistemaAPI.DTOs.PublicProductInfoDto
@{
    ViewData["Title"] = Model.Name;
}

<section class="py-5">
    <div class="container">
        <div class="row align-items-start">
            <div class="col-lg-6 text-center mb-4">
                <img src="@Model.ImageFullPath" class="img-fluid rounded shadow-lg">
            </div>
            <div class="col-lg-6">
                <h2 class="fw-bold">@Model.Name</h2>
                <p class="text-secondary">@Model.Description</p>
                <hr>
                <h5 class="text-secondary fw-bold">Modo de Aplicação</h5>
                <p>@Model.ApplicationMethod</p>
                <h5 class="text-secondary fw-bold mt-4">Ingredientes</h5>
                <p class="text-muted small">@Model.Ingredients</p>
            </div>
        </div>
    </div>
</section>

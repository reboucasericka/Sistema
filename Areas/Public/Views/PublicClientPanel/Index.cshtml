@{
    ViewData["Title"] = "Minha Área - Painel do Cliente";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}

<!-- ===== Estilo Premium ===== -->
<link href="~/css/client-panel.css" rel="stylesheet" />

<!-- ===== Layout ===== -->

<div class="container-fluid px-4">
    <!-- Header -->
    <div class="page-header my-4 p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h2><i class="fas fa-spa me-2"></i>Olá, @ViewBag.CustomerName</h2>
                <p class="opacity-75 mb-0">Bem-vinda à sua área de agendamentos e serviços exclusivos.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3 mt-md-0">
                <a asp-controller="PublicBooking" asp-action="Index" class="btn btn-main btn-sm">
                    <i class="fas fa-calendar-plus"></i> Novo Agendamento
                </a>
                <a asp-action="MyAppointments" class="btn btn-outline-light btn-sm border-light text-light">
                    <i class="fas fa-list"></i> Meus Agendamentos
                </a>
            </div>
        </div>
    </div>

    <!-- Página intencionalmente vazia: navegação pelas abas do menu lateral -->
    <div class="row g-4">
        <div class="col-12">
            
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="appointmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">Detalhes do Agendamento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="appointment-details">
                <!-- Conteúdo dinâmico -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-danger" id="cancel-appointment-btn" style="display:none;">
                    <i class="fas fa-times"></i> Cancelar Agendamento
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts { }

@Html.AntiForgeryToken()

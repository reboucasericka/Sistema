@{
    var categories = ViewBag.Categories as List<Sistema.Data.Entities.Category> ?? new List<Sistema.Data.Entities.Category>();
}

<div class="card shadow-sm mb-3">
    <div class="card-header bg-light">
        <h6 class="card-title mb-0">
            <i class="bi bi-funnel"></i> Filtros de Serviços
        </h6>
    </div>
    <div class="card-body">
        <form id="filter-form">
            <div class="mb-3">
                <label for="categoryId" class="form-label">Categoria</label>
                <select class="form-select" id="categoryId" name="categoryId">
                    <option value="">Todas as categorias</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.CategoryId">@category.Name</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="minPrice" class="form-label">Preço Mínimo (€)</label>
                <input type="number" class="form-control" id="minPrice" name="minPrice" min="0" step="0.01" placeholder="0.00">
            </div>

            <div class="mb-3">
                <label for="maxPrice" class="form-label">Preço Máximo (€)</label>
                <input type="number" class="form-control" id="maxPrice" name="maxPrice" min="0" step="0.01" placeholder="100.00">
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-search"></i> Aplicar Filtros
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="clear-filters">
                    <i class="bi bi-x-circle"></i> Limpar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h6 class="card-title mb-0">
            <i class="bi bi-funnel"></i> Filtros de Produtos
        </h6>
    </div>
    <div class="card-body">
        <form id="product-filter-form">
            <div class="mb-3">
                <label for="productCategoryId" class="form-label">Categoria</label>
                <select class="form-select" id="productCategoryId" name="categoryId">
                    <option value="">Todas as categorias</option>
                    <!-- Será preenchido via JavaScript -->
                </select>
            </div>

            <div class="mb-3">
                <label for="productMinPrice" class="form-label">Preço Mínimo (€)</label>
                <input type="number" class="form-control" id="productMinPrice" name="minPrice" min="0" step="0.01" placeholder="0.00">
            </div>

            <div class="mb-3">
                <label for="productMaxPrice" class="form-label">Preço Máximo (€)</label>
                <input type="number" class="form-control" id="productMaxPrice" name="maxPrice" min="0" step="0.01" placeholder="100.00">
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-info btn-sm">
                    <i class="bi bi-search"></i> Aplicar Filtros
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="clear-product-filters">
                    <i class="bi bi-x-circle"></i> Limpar
                </button>
            </div>
        </form>
    </div>
</div>
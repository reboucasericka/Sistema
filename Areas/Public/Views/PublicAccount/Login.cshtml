@model Sistema.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Login Cliente";
    Layout = "~/Views/Shared/_Login.cshtml";
}

<!-- ========================================= -->
<!-- ÁREA DE LOGIN DO CLIENTE (PÚBLICA) -->
<!-- ========================================= -->
<div class="container d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="card shadow-lg border-0 p-4" style="max-width: 420px; width: 100%; border-radius: 16px;">
        <!-- Cabeçalho -->
        <div class="text-center mb-4">
            <img src="~/images/logo.png" alt="Ewellin Beauty" style="height: 60px;" />
            <h3 class="mt-3 fw-bold text-dark">
                <i class="fas fa-sign-in-alt me-2 text-primary"></i>Entrar na sua conta
            </h3>
            <p class="text-muted mb-0">Acesse o painel do cliente para agendar serviços</p>
        </div>

        <!-- Formulário -->
        <form asp-area="Public" asp-controller="PublicAccount" asp-action="Login" method="post" class="needs-validation">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <!-- Usuário -->
            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-semibold">
                    <i class="fas fa-user me-2 text-primary"></i>E-mail ou Username
                </label>
                <input asp-for="Username" class="form-control form-control-lg" placeholder="Digite seu e-mail ou usuário" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <!-- Senha -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold">
                    <i class="fas fa-lock me-2 text-primary"></i>Senha
                </label>
                <div class="position-relative">
                    <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Digite sua senha" />
                    <button type="button"
                            class="btn position-absolute end-0 top-50 translate-middle-y pe-3"
                            onclick="togglePassword()"
                            style="border: none; background: none; color: var(--accent-terracotta);">
                        <i class="fas fa-eye" id="toggleIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <!-- Lembrar de mim -->
            <div class="form-check mb-3">
                <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Lembrar de mim</label>
            </div>

            <!-- Botão principal -->
            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                    <i class="fas fa-sign-in-alt me-2"></i>Entrar
                </button>
            </div>

            <!-- Registrar -->
            <div class="text-center mt-3">
                <p class="text-muted mb-1">Ainda não tem uma conta?</p>
                <a asp-area="Public" asp-controller="PublicAccount" asp-action="Register" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-user-plus me-1"></i> Cadastre-se aqui
                </a>
            </div>

            <!-- Login Social -->
            <div class="mt-4 text-center">
                <span class="text-muted">ou continue com</span>
                <div class="d-flex justify-content-center gap-3 mt-3">
                    <a asp-controller="PublicAccount" asp-action="ExternalLogin" asp-route-provider="Facebook"
                       asp-route-returnUrl="@Context.Request.Query["returnUrl"]"
                       class="btn btn-outline-primary rounded-circle" title="Facebook">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a asp-controller="PublicAccount" asp-action="ExternalLogin" asp-route-provider="Google"
                       asp-route-returnUrl="@Context.Request.Query["returnUrl"]"
                       class="btn btn-outline-danger rounded-circle" title="Google">
                        <i class="fab fa-google"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        // Alternar exibição de senha
        function togglePassword() {
            const passwordInput = document.querySelector('input[name="Password"]');
            const toggleIcon = document.getElementById('toggleIcon');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        // Pequena animação ao focar nos campos
        document.querySelectorAll('.form-control').forEach(input => {
            input.addEventListener('focus', () => input.classList.add('shadow-sm'));
            input.addEventListener('blur', () => input.classList.remove('shadow-sm'));
        });

        // Limpar storage e cache local ao carregar
        document.addEventListener('DOMContentLoaded', () => {
            try {
                localStorage.clear();
                sessionStorage.clear();
            } catch {}
            if ('caches' in window) {
                caches.keys().then(names => names.forEach(name => caches.delete(name)));
            }
        });
    </script>
}

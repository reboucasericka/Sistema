@model SistemaAPI.DTOs.PublicProductInfoDto
@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-5">
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.ImageFullPath" class="img-fluid rounded shadow-sm" alt="@Model.Name" />
        </div>
        <div class="col-md-6">
            <h2 class="fw-bold">@Model.Name</h2>
            <p class="text-muted">@Model.Description</p>
            <p class="badge bg-secondary">@Model.Category</p>
            <hr />
            <a asp-area="Public" asp-controller="PublicProducts" asp-action="Index"
               class="btn btn-outline-secondary">
                ← Voltar
            </a>
        </div>
    </div>
</div>
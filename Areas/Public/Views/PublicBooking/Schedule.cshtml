@model SistemaAPI.DTOs.ServiceDto
@{
    ViewData["Title"] = "Escolha o seu horário";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Poppins:wght@400;500&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/booking-flow.css" />

<div class="container-fluid px-4">
    <div class="flow-header">
        <button class="link" onclick="history.back()"><i class="fas fa-arrow-left"></i> Anterior</button>
        <h2>Escolha o seu horário</h2>
        <div></div>
    </div>

    <div class="day-strip" id="dayStrip"></div>

    <div class="selected-time">
        <span>Horário selecionado:</span>
        <strong id="selectedTimeBadge">—</strong>
    </div>

    <div id="daySlots" class="slots-container">
        <div class="text-muted py-4 text-center">A carregar horários…</div>
    </div>

    <h5 class="mt-4 mb-2">Profissional</h5>
    <div id="staffGrid" class="staff-grid">
        <div class="text-muted py-4 text-center">Selecione um horário para ver profissionais.</div>
    </div>

    <form id="confirmForm" asp-action="Confirm" method="post" class="confirm-bar">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ServiceId" value="@Model.ServiceId" />
        <input type="hidden" name="Date" id="confirmDate" />
        <input type="hidden" name="Time" id="confirmTime" />
        <input type="hidden" name="ProfessionalId" id="confirmProf" />
        <input type="hidden" name="Notes" value="" />

        <div class="summary">
            <div>
                <div class="s-title">@Model.Name</div>
                <div class="s-sub">@Model.DurationInMinutes min • @Model.CategoryName</div>
            </div>
            <div class="s-price">@String.Format(new System.Globalization.CultureInfo("pt-PT"), "{0:C}", @Model.Price)</div>
        </div>
        <button type="submit" class="btn-confirm" disabled id="confirmBtn">
            <i class="fas fa-check"></i> Confirmar agendamento
        </button>
        <a class="btn-google" href="/Public/PublicAccount/LinkGoogleCalendar">
            <i class="fab fa-google"></i> Ligar Google Calendar
        </a>
    </form>
</div>

@section Scripts {
    <script>
        const serviceId = @Model.ServiceId;
        const baseUrl = '@Url.Content("~/")';
    </script>
    <script src="~/js/booking-flow.js"></script>
}

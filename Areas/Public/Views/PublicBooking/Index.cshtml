@model IEnumerable<SistemaAPI.DTOs.ServiceDto>

@{
    ViewData["Title"] = "Agendamento Online";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}

<link href="~/css/public-booking.css" rel="stylesheet" />
<script src="~/js/shared/ui-helpers.js"></script>

<div class="container-fluid px-4">
    <!-- Header Principal -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="booking-header my-4 p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="mb-1">
                            <i class="fas fa-calendar-plus"></i>
                            Agendamento Online
                        </h2>
                        <p class="mb-0 opacity-75">Escolha seu serviço e agende seu horário</p>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Index" asp-controller="PublicClientPanel" class="btn btn-outline-light btn-sm border-light text-light">
                            <i class="fas fa-home"></i> Minha Área
                        </a>
                        <a asp-action="MyAppointments" asp-controller="PublicClientPanel" class="btn btn-outline-light btn-sm border-light text-light">
                            <i class="fas fa-list"></i> Meus Agendamentos
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar de Filtros -->
        <div class="col-md-3 col-lg-2">
            <div class="filter-section">
                <div class="sidebar-title">Filtros</div>
                <!-- Data -->
                <div class="mb-3">
                    <label class="form-label">Quando deseja agendar</label>
                    <input type="date" class="form-control" id="bookingDate" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                </div>

                <!-- Categorias -->
                <div class="mb-3">
                    <label class="form-label">Categorias</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="Pestanas">
                        <label class="form-check-label" for="Pestanas">Pestanas</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="barbearia">
                        <label class="form-check-label" for="barbearia">Barbearia</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="cabelos">
                        <label class="form-check-label" for="cabelos">Cabelos</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="depilacao">
                        <label class="form-check-label" for="depilacao">Depilação</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="maquiagem">
                        <label class="form-check-label" for="maquiagem">Maquiagem</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="massagem">
                        <label class="form-check-label" for="massagem">Massagem e Estética</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="podologia">
                        <label class="form-check-label" for="podologia">Podologia</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="sobrancelhas">
                        <label class="form-check-label" for="sobrancelhas">Sobrancelhas</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="unhas">
                        <label class="form-check-label" for="unhas">Unhas</label>
                    </div>
                </div>

                <!-- Facilidades -->
                <div class="mb-3">
                    <label class="form-label">Facilidades</label>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge bg-warning text-dark small">Agendamento online</span>
                        <span class="badge bg-warning text-dark small">Aceita cartão</span>
                        <span class="badge bg-warning text-dark small">WiFi</span>
                        <span class="badge bg-warning text-dark small">Acessível</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Conteúdo Principal -->
        <div class="col-md-9 col-lg-10">
            <!-- Lista de Serviços -->
            <div class="row">
                @foreach (var service in Model)
                {
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card h-100 border-0 service-card" data-service-id="@service.ServiceId">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="card-title mb-0">@service.Name</h6>
                                    <span class="badge badge-category">@service.CategoryName</span>
                                </div>
                                <p class="card-text text-muted small mb-3">@service.Description</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-muted">
                                            <i class="fas fa-clock"></i> @service.DurationInMinutes minutos
                                        </small>
                                    </div>
                                    <div class="text-end">
                                        <strong class="text-success fs-5">@String.Format(new System.Globalization.CultureInfo("pt-PT"), "{0:C}", service.Price)</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-white">
                                <a asp-area="Public" asp-controller="PublicBooking" asp-action="Schedule" asp-route-id="@service.ServiceId" class="btn btn-main btn-sm w-100">
                                    <i class="fas fa-calendar-plus"></i> Agendar
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/public-booking.js"></script>
}

@Html.AntiForgeryToken()

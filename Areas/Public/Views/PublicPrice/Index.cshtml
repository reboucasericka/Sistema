    padding: 8px 0;
    border-bottom: 1px solid #eee;
}
.price-category li em {
    font-size: 0.9em;
    color: var(--secondary-olive);
}
.price-category li span {
    color: var(--accent-peach);
    font-weight: 600;
}
.disclaimer {

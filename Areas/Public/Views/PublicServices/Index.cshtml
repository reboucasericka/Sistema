@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Serviços - Sistema";
}

<section class="services-section">
    <div class="container py-5">

        <!-- Hero Section -->
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold text-accent">Nossos Serviços</h1>
            <p class="lead text-muted">Cuide da sua beleza com quem entende de elegância e técnica.</p>
        </div>

        <!-- Services Grid -->
        <div class="row g-4 justify-content-center">

            <!-- Serviço 1 -->
            <div class="col-md-4">
                <div class="service-card shadow-sm">
                    <img src="/images/services/sobrancelha.jpg" alt="Design de Sobrancelhas" class="service-image" onerror="this.src='/images/noimage.png'" />
                    <div class="service-content p-4">
                        <h3 class="fw-bold text-accent">Design de Sobrancelhas</h3>
                        <p class="text-muted">Modelagem personalizada que valoriza seu formato natural e expressões faciais.</p>
                        <p class="price">€39,00</p>
                        <a asp-area="Public" asp-controller="PublicAccount" asp-action="Login" class="btn btn-primary w-100">Agendar Serviço</a>
                    </div>
                </div>
            </div>

            <!-- Serviço 2 -->
            <div class="col-md-4">
                <div class="service-card shadow-sm">
                    <img src="/images/services/cilios.jpg" alt="Extensão de Cílios" class="service-image" onerror="this.src='/images/noimage.png'" />
                    <div class="service-content p-4">
                        <h3 class="fw-bold text-accent">Extensão de Cílios Volume Russo</h3>
                        <p class="text-muted">Técnica de fios ultrafinos que garante volume, leveza e curvatura perfeitos.</p>
                        <p class="price">€89,00</p>
                        <a asp-area="Public" asp-controller="PublicAccount" asp-action="Login" class="btn btn-primary w-100">Agendar Serviço</a>
                    </div>
                </div>
            </div>

            <!-- Serviço 3 -->
            <div class="col-md-4">
                <div class="service-card shadow-sm">
                    <img src="/images/services/coloracao.jpg" alt="Coloração de Sobrancelhas" class="service-image" onerror="this.src='/images/noimage.png'" />
                    <div class="service-content p-4">
                        <h3 class="fw-bold text-accent">Coloração de Sobrancelhas</h3>
                        <p class="text-muted">Técnica de pigmentação leve que realça a cor natural dos fios e preenche falhas.</p>
                        <p class="price">€59,00</p>
                        <a asp-area="Public" asp-controller="PublicAccount" asp-action="Login" class="btn btn-primary w-100">Agendar Serviço</a>
                    </div>
                </div>
            </div>

            <!-- Serviço 4 -->
            <div class="col-md-4">
                <div class="service-card shadow-sm">
                    <img src="/images/services/microblading.jpg" alt="Micropigmentação" class="service-image" onerror="this.src='/images/noimage.png'" />
                    <div class="service-content p-4">
                        <h3 class="fw-bold text-accent">Micropigmentação</h3>
                        <p class="text-muted">Procedimento de longa duração com resultado natural e expressivo.</p>
                        <p class="price">€150,00</p>
                        <a asp-area="Public" asp-controller="PublicAccount" asp-action="Login" class="btn btn-primary w-100">Agendar Serviço</a>
                    </div>
                </div>
            </div>

            <!-- Serviço 5 -->
            <div class="col-md-4">
                <div class="service-card shadow-sm">
                    <img src="/images/services/lifting.jpg" alt="Lifting de Cílios" class="service-image" onerror="this.src='/images/noimage.png'" />
                    <div class="service-content p-4">
                        <h3 class="fw-bold text-accent">Lifting de Cílios</h3>
                        <p class="text-muted">Realce natural e curvatura perfeita para seus cílios, sem necessidade de extensão.</p>
                        <p class="price">€75,00</p>
                        <a asp-area="Public" asp-controller="PublicAccount" asp-action="Login" class="btn btn-primary w-100">Agendar Serviço</a>
                    </div>
                </div>
            </div>

            <!-- Serviço 6 -->
            <div class="col-md-4">
                <div class="service-card shadow-sm">
                    <img src="/images/services/hydralips.jpg" alt="Hydra Lips" class="service-image" onerror="this.src='/images/noimage.png'" />
                    <div class="service-content p-4">
                        <h3 class="fw-bold text-accent">Hydra Lips</h3>
                        <p class="text-muted">Técnica de revitalização labial que proporciona cor, hidratação e volume natural.</p>
                        <p class="price">€120,00</p>
                        <a asp-area="Public" asp-controller="PublicAccount" asp-action="Login" class="btn btn-primary w-100">Agendar Serviço</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mensagem final -->
        <div class="text-center mt-5">
            <p class="text-muted">
                Para realizar um agendamento, é necessário ter uma conta no sistema. <br />
                Faça seu <a asp-area="Public" asp-controller="PublicAccount" asp-action="Login" class="link-accent">login</a> ou <a asp-area="Public" asp-controller="PublicAccount" asp-action="Register" class="link-accent">cadastro</a> agora mesmo.
            </p>
        </div>
    </div>
</section>

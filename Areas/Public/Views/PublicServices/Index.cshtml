@model IEnumerable<Sistema.Data.Entities.Service>
@{
    ViewData["Title"] = "Serviços";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<section class="services-hero">
    <div class="hero-background">
        <div class="hero-pattern"></div>
        <div class="hero-overlay"></div>
    </div>
    <div class="container">
        <div class="hero-content text-center">
            <div class="hero-subtitle">LOJAS QUIOSQUES</div>
            <h1 class="hero-title">SERVIÇOS</h1>
        </div>
    </div>
</section>

<!-- Services Grid -->
<section class="services-grid py-5">
    <div class="container">
        <div class="row" id="servicesContainer">
            @foreach (var service in Model.Where(s => s.IsActive))
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4 service-card" data-service-id="@service.ServiceId">
                    <div class="service-item" onclick="openServiceModal(@service.ServiceId)">
                        <div class="service-image">
                            <img src="@service.ImageFullPath" alt="@service.Name" class="img-fluid">
                        </div>
                        <div class="service-content">
                            <h3 class="service-name">@service.Name</h3>
                            <p class="service-category">@service.Category?.Name</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Service Details Modal -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-labelledby="serviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content service-modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="serviceModalLabel">Detalhes do Serviço</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="service-modal-image">
                            <img id="modalServiceImage" src="" alt="" class="img-fluid">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="service-modal-info">
                            <h2 id="modalServiceName" class="service-modal-title"></h2>
                            
                            <div class="service-details">
                                <div class="detail-item">
                                    <h4>O QUE É?</h4>
                                    <p id="modalServiceDescription"></p>
                                </div>
                                
                                <div class="detail-item">
                                    <h4><i class="fas fa-clock"></i> TEMPO DE SERVIÇO</h4>
                                    <p id="modalServiceDuration"></p>
                                </div>
                                
                                <div class="detail-item">
                                    <h4><i class="fas fa-calendar-alt"></i> DURABILIDADE</h4>
                                    <p id="modalServiceDurability"></p>
                                </div>
                                
                                <div class="detail-item">
                                    <h4><i class="fas fa-check-circle"></i> RESULTADO</h4>
                                    <p id="modalServiceResult"></p>
                                </div>
                            </div>
                            
                            <div class="service-price">
                                <span class="price-label">Preço:</span>
                                <span id="modalServicePrice" class="price-value"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <a href="#" id="bookServiceBtn" class="btn btn-primary">
                    <i class="fas fa-calendar-plus"></i>
                    Agendar Serviço
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Hero Section */
    .services-hero {
        position: relative;
        height: 400px;
        background: linear-gradient(135deg, #c48ba4 0%, #f7d7e0 100%);
        display: flex;
        align-items: center;
        overflow: hidden;
    }

    .hero-background {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
    }

    .hero-pattern {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="servicesPattern" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="20" cy="20" r="2" fill="rgba(255,255,255,0.1)"/><circle cx="80" cy="80" r="2" fill="rgba(255,255,255,0.1)"/><circle cx="50" cy="10" r="1" fill="rgba(255,255,255,0.1)"/><circle cx="10" cy="90" r="1" fill="rgba(255,255,255,0.1)"/></pattern></defs><rect width="100" height="100" fill="url(%23servicesPattern)"/></svg>');
        opacity: 0.3;
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.1);
    }

    .hero-content {
        position: relative;
        z-index: 2;
        color: white;
    }

    .hero-subtitle {
        font-size: 1rem;
        font-weight: 500;
        letter-spacing: 2px;
        margin-bottom: 10px;
        opacity: 0.9;
    }

    .hero-title {
        font-family: 'Playfair Display', serif;
        font-size: 4rem;
        font-weight: 700;
        margin: 0;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    /* Services Grid */
    .services-grid {
        background: #f8f9fa;
        min-height: 60vh;
    }

    .service-card {
        opacity: 1;
        transform: translateY(0);
        transition: all 0.3s ease;
    }

    .service-card.hidden {
        opacity: 0;
        transform: translateY(20px);
        pointer-events: none;
    }

    .service-item {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        cursor: pointer;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .service-item:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.15);
    }

    .service-image {
        height: 200px;
        overflow: hidden;
        position: relative;
    }

    .service-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .service-item:hover .service-image img {
        transform: scale(1.05);
    }

    .service-content {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        text-align: center;
    }

    .service-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #c48ba4;
        margin-bottom: 8px;
        line-height: 1.3;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .service-category {
        font-size: 0.9rem;
        color: #666;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    /* Modal Styles */
    .service-modal-content {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

    .modal-header {
        background: #c48ba4;
        color: white;
        border: none;
        padding: 20px 30px;
    }

    .modal-title {
        font-weight: 600;
        font-size: 1.3rem;
    }

    .btn-close {
        filter: invert(1);
    }

    .modal-body {
        padding: 30px;
    }

    .service-modal-image {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .service-modal-image img {
        width: 100%;
        height: 300px;
        object-fit: cover;
    }

    .service-modal-title {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .service-details {
        margin-bottom: 25px;
    }

    .detail-item {
        margin-bottom: 20px;
    }

    .detail-item h4 {
        font-size: 1rem;
        font-weight: 600;
        color: #c48ba4;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .detail-item h4 i {
        font-size: 0.9rem;
    }

    .detail-item p {
        color: #666;
        line-height: 1.5;
        margin: 0;
        font-size: 0.95rem;
    }

    .service-price {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 10px;
        text-align: center;
        border: 2px solid #c48ba4;
    }

    .price-label {
        font-size: 0.9rem;
        color: #666;
        margin-right: 10px;
    }

    .price-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #c48ba4;
    }

    .modal-footer {
        background: #f8f9fa;
        border: none;
        padding: 20px 30px;
    }

    .modal-footer .btn {
        padding: 10px 25px;
        border-radius: 25px;
        font-weight: 500;
    }

    .btn-primary {
        background: #c48ba4;
        border-color: #c48ba4;
    }

    .btn-primary:hover {
        background: #a06b8a;
        border-color: #a06b8a;
    }

    /* Animações */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .service-card {
        animation: fadeInUp 0.6s ease forwards;
    }

    .service-card:nth-child(1) { animation-delay: 0.1s; }
    .service-card:nth-child(2) { animation-delay: 0.2s; }
    .service-card:nth-child(3) { animation-delay: 0.3s; }
    .service-card:nth-child(4) { animation-delay: 0.4s; }
    .service-card:nth-child(5) { animation-delay: 0.5s; }
    .service-card:nth-child(6) { animation-delay: 0.6s; }
    .service-card:nth-child(7) { animation-delay: 0.7s; }
    .service-card:nth-child(8) { animation-delay: 0.8s; }

    /* Responsividade */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.5rem;
        }
        
        .hero-subtitle {
            font-size: 0.9rem;
        }
        
        .service-modal-title {
            font-size: 1.5rem;
        }
        
        .modal-body {
            padding: 20px;
        }
        
        .service-modal-image img {
            height: 200px;
        }
    }

    @@media (max-width: 576px) {
        .hero-title {
            font-size: 2rem;
        }
        
        .service-name {
            font-size: 1rem;
        }
        
        .service-category {
            font-size: 0.8rem;
        }
    }
</style>

<script>
    // Dados dos serviços (simulados - em produção viriam do servidor)
    const servicesData = {
        @foreach (var service in Model.Where(s => s.IsActive))
        {
            <text>
            @service.ServiceId: {
                name: "@service.Name",
                category: "@service.Category?.Name",
                description: "@(string.IsNullOrEmpty(service.Description) ? "Descrição detalhada do serviço será adicionada em breve." : service.Description)",
                price: "@service.Price.ToString("F2")",
                duration: "@service.DurationInMinutes minutos",
                durability: "@(service.ReturnDays > 0 ? service.ReturnDays + " dias" : "6 meses - 1 ano")",
                result: "Resultado natural e duradouro",
                image: "@service.ImageFullPath",
                bookingUrl: "@Url.Action("Create", "PublicBooking", new { serviceId = service.ServiceId })"
            },
            </text>
        }
    };

    function openServiceModal(serviceId) {
        const service = servicesData[serviceId];
        if (!service) return;

        // Preencher o modal com os dados do serviço
        document.getElementById('modalServiceName').textContent = service.name;
        document.getElementById('modalServiceDescription').textContent = service.description;
        document.getElementById('modalServiceDuration').textContent = service.duration;
        document.getElementById('modalServiceDurability').textContent = service.durability;
        document.getElementById('modalServiceResult').textContent = service.result;
        document.getElementById('modalServicePrice').textContent = '€' + service.price;
        document.getElementById('modalServiceImage').src = service.image;
        document.getElementById('modalServiceImage').alt = service.name;
        document.getElementById('bookServiceBtn').href = service.bookingUrl;

        // Mostrar o modal
        const modal = new bootstrap.Modal(document.getElementById('serviceModal'));
        modal.show();
    }

    // Adicionar efeito de hover nos cards
    document.addEventListener('DOMContentLoaded', function() {
        const serviceCards = document.querySelectorAll('.service-item');
        
        serviceCards.forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-5px)';
            });
            
            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });
    });
</script>
<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- CORES PRINCIPAIS PERSONALIZADAS -->
    <Color x:Key="Primary">#ffffff</Color> <!-- branco -->
    <Color x:Key="Secondary">#f8f8fa</Color> <!-- fundo cinza-claro -->
    <Color x:Key="Accent">#6A0DAD</Color> <!-- lilás personalizado -->
    <Color x:Key="BackgroundColor">#f8f8fa</Color>
    <Color x:Key="TextColor">#222222</Color>
    <Color x:Key="ErrorColor">#ff4d4d</Color>

</ResourceDictionary>
